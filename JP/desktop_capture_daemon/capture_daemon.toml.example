interval_seconds = 60
capture_after_source_ready = false
manual_capture_hotkey = "Alt+Q"
ocr_max_side = 1600
dedupe_window = 12
perceptual_dedupe_enabled = false
phash_distance_threshold = 6
auto_start_worker = false
auto_process_jobs = true

# When capture_after_source_ready = true, the daemon waits until the current
# OCR/source pipeline is idle before taking the next capture. This works best
# with auto_start_worker = false and auto_process_jobs = true.
# manual_capture_hotkey is a global shortcut for "Capture now". Supported keys
# include A-Z, 0-9, F1-F24, arrows, Insert/Delete/Home/End/PageUp/PageDown,
# Space, Tab, Enter, Escape, Backspace, and PrintScreen.
# perceptual_dedupe_enabled compares each new frame with the recent capture
# window using pHash. Leave it off unless you explicitly want to discard
# visually similar frames, since small but important UI changes can be skipped.

# Optional overrides. If omitted, the daemon uses the repository-local defaults
# under JP/data and launches JP/capture_worker.py with ../.venv-capture312 when
# it exists (that venv has meikiocr), falling back to `py -3.12` otherwise.
# Relative paths are resolved from the JP/ directory, so they keep working if
# the Windows username or workspace root changes.
#
# db_path = "data/lang_jp.sqlite3"
# spool_dir = "data/capture_spool"
# log_path = "data/capture_daemon.log"
# python_executable = "../.venv-capture312/Scripts/python.exe"
# python_args = ["-3.12"]
# worker_script = "capture_worker.py"

# Catalog web server supervised by the daemon (lang_jp.py browse). It uses the
# worker's Python unless web_python_executable/web_python_args are set.
#
# web_server_enabled = true
# web_port = 8766
# web_python_executable = "../.venv/Scripts/python.exe"
# web_python_args = []
# web_log_path = "data/catalog_web.log"

# Capture languages are NOT configured here: they live in the database
# (languages.capture_enabled) and are edited from the tray menu ("Capture
# languages"), the web UI (/capture) or the CLI (set-capture-languages,
# enable-language --capture/--no-capture). The worker reads them per job, so no
# restart is needed. LANG_CAPTURE_LANGUAGES in the worker environment is only an
# override for one-off runs.

# Record the foreground window (title and process name) with every capture job.
# Capture profiles (/capture in the web UI, add-capture-profile in the CLI) match
# on these to pin a window to a fixed language set, and sources get the window
# title. Set to false to store nothing about the active window.
# record_foreground_window = true

# Reading overlay (JP/translate_overlay.py), started and kept running by the
# daemon. overlay_hotkey shows/hides it, overlay_mode_hotkey cycles translation
# -> furigana -> word by word ("" disables it). On/off, mode and languages are
# set from the tray ("Reading overlay") and stored in overlay_state_path.
#
# overlay_hotkey = "Ctrl+Alt+Q"
# overlay_mode_hotkey = "Ctrl+Alt+W"
# overlay_script = "translate_overlay.py"
# overlay_state_path = "data/translate_overlay.toml"
# overlay_log_path = "data/translate_overlay.log"
